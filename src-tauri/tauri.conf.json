{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSpace",
  "version": "0.1.0",
  "identifier": "com.filespace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileSpace",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 400,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
